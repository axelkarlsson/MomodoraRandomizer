<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="42">
  <CheatEntries>
    <CheatEntry>
      <ID>2350</ID>
      <Description>"Debug"</Description>
      <Options moAlwaysHideChildren="1" moManualExpandCollapse="1"/>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>6</ID>
          <Description>"Enable for numpad 0 to respawn"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}

if syntaxcheck then return end
--only continue if this is 1.05b

if t then t.destroy(); t = nil end
if(size == nil) then
        size = getModuleSize(process)
end

--1.05b
if(size == 39690240) then
  if(aobresult1 == nil) then
  aobresult1 = AOBScan("0F 84 ?? ?? ?? ?? C7 84 24 18 06 00 00 A6 01 00 00 8B 84 24 98 00 00 00")
  end
  if(aobresult2 == nil) then
  aobresult2 = AOBScan("76 56 C7 84 24 18 06 00 00 A8 01 00 00 B8 FF FF FF 00 8B 8C 24 A4 00 00 00 23 81 7C 04 00 00 83 F8 01")
  end
  if(aobresult3 == nil) then
  aobresult3 = AOBScan("0F 86 ?? ?? ?? ?? 89 C6 C7 84 24 18 06 00 00 B7 01 00 00 8B 47 04")
  end
  -- Declare array to fix bytes later on
  byteFix = {0x96, 0x05}
end
--1.07
if(size == 40222720) then
  if(aobresult1 == nil) then
  aobresult1 = AOBScan("0F 84 ?? ?? ?? ?? 89 F3 C7 84 24 20 06 00 00 A6 01 00 00 8B 84 24 98 00 00 00")
  end
  if(aobresult2 == nil) then
  aobresult2 = AOBScan("76 56 C7 84 24 20 06 00 00 A8 01 00 00 B8 FF FF FF 00 8B 8C 24 A8 00 00 00 23 81 7C 04 00 00 83 F8 01")
  end
  if(aobresult3 == nil) then
  aobresult3 = AOBScan("0F 86 ?? ?? ?? ?? 89 F7 89 C6 C7 84 24 20 06 00 00 B7 01 00 00 8B 45 08")
  end
  -- Declare array to fix bytes later on
  byteFix = {0xA4, 0x90}
end

curKs=false
t = createTimer()
t.Interval=16
t.OnTimer=function(t)

  if isKeyPressed(VK_NUMPAD0) then
      -- key is down, wait until its not?
      curKs=true
  else
     -- key is up
     -- but was it pressed?
     if curKs then
        -- write our shit
        -- aobresult1[0]
        writeBytes(aobresult1[0], 0x90, 0x90, 0x90, 0x90, 0x90, 0x90)

        -- aobresult2[0]
        writeBytes(aobresult2[0], 0x90, 0x90)

        -- wait 1~ frame
        sleep(16)

        -- write bytes for confirm to happen
        -- aobresult3[0]
        writeBytes(aobresult3[0], 0x90, 0x90, 0x90, 0x90, 0x90, 0x90)

        -- wait 1~ frame
        sleep(16)

        -- then fix the instant confirm, so we don't keep respawning
        -- aobresult3[0]
        writeBytes(aobresult3[0], 0x0F, 0x86, byteFix[1], 0x01, 0x00, 0x00)

        -- turn off the invisible menu
        writeBytes(aobresult1[0], 0x0F, 0x84, byteFix[2], 0x14, 0x00, 0x00)
        writeBytes(aobresult2[0], 0x76, 0x56)
        -- invalidate we knew it was pressed
        curKs=false
     end
  end
end

t.Enabled=true
[DISABLE]
{$lua}
curKs=false
if t then t.destroy(); t=nil end
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>7</ID>
          <Description>"Enable for numpad 1 to cycle debug modes"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
[ENABLE]

if(aob1 == nil) then
    aob1 = AOBScan("A1 ?? ?? ?? ?? 8B 40 04 8D 88 C0 00 00 00 8D 90 D0 00 00 00 8D B0 E0 00 00 00 C7 44 24 30 00 00 00 00 89 4C 24 20 89 54 24 24")
end
if(size == nil) then
    size = getModuleSize(process)
end
--Declare offset of debug variable
--1.05
if(size == 39690240) then
    offset = 0xAE0
end
--1.07
if(size == 40222720) then
    offset = 0xAF0
end

n = tonumber(aob1[0],16) + 0x1
n = readInteger(n)
a = readPointer(n)
a = readPointer(a + 0x4)

debugState=0
curKs2=false
t2 = createTimer()
t2.Interval=16
t2.OnTimer=function(t2)

  if isKeyPressed(VK_NUMPAD1) then
      -- key is down, wait until its not?
      curKs2=true
  else
     -- key is up
     -- but was it pressed?
     if curKs2 then
        -- write our shit
        debugState = debugState + 1
        if(debugState &gt; 2) then
            debugState = 0
        end
        writeDouble(a+offset, debugState)
        curKs2=false
     end
  end
end

[DISABLE]
a=readPointer(n)
a=readPointer(a+0x4)
writeDouble(a+offset, 0.0)
if t2 then t2.destroy(); t2=nil end
</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
